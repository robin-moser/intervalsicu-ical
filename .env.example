# Intervals.icu API key (Settings > Developer Settings > API Key)
INTERVALS_API_KEY=your_api_key_here

# Intervals.icu athlete ID (shown on settings page, starts with "i")
INTERVALS_ATHLETE_ID=i12345

# HTTP port the calendar feed is served on
PORT=8491

# Timezone of Intervals.icu local start times and date ranges (IANA format)
TZ=America/Denver

# How many days back to fetch completed activities
PAST_DAYS=90

# How many days ahead to fetch planned events
FUTURE_DAYS=60

# How often (minutes) to refresh data during active hours
ACTIVE_REFRESH_MINUTES=10

# How often (minutes) to refresh data during quiet hours
QUIET_REFRESH_MINUTES=30

# Active refresh window start (24h format)
ACTIVE_START_HOUR=6

# Active refresh window end (24h format)
ACTIVE_END_HOUR=22

# Comma-separated keywords to exclude from the calendar (case-insensitive, matches activity/event name).
# Leave empty to include everything.
# EXCLUDED_KEYWORDS=rest,recovery,test

# Whether to include all-day events (planned workouts with no specific time).
# Set to false to only show timed events.
INCLUDE_ALL_DAY_EVENTS=true

# Whether to include future RACE events beyond the FUTURE_DAYS sync window.
# When true, fetches up to 1 year ahead for RACE category events only.
INCLUDE_FUTURE_RACES=true

# Whether to include daily metrics as all-day events (CTL/ATL/TSB, weight, HRV, sleep, etc).
# Only includes past and today (no future metrics). Displayed with emojis.
INCLUDE_METRICS=false
